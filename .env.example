# --- Server ---
PORT=3000
PUBLIC_BASE_URL=https://tambala-mcp.onrender.com
TAMBALA_MCP_TOKEN=            # legacy shared token (32+ chars)
TAMBALA_OAUTH_SECRET=         # 32+ chars
TAMBALA_OAUTH_APPROVAL_CODE=  # 12+ chars
TAMBALA_CHAT_TEST_TOKEN=      # protects /chat-live and /api/chat-test/*

# --- Database ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Agents (repeat per agent: ORCHESTRATOR, OUTREACH, FOLLOWUP, RESEARCH, MARKETING, CONTENT, FINANCE, PAYMENTS, ENGINEERING, ...) ---
TAMBALA_ORCHESTRATOR_API_KEY=
TAMBALA_ORCHESTRATOR_BASE_URL=https://api.groq.com/openai/v1
TAMBALA_ORCHESTRATOR_MODEL=openai/gpt-oss-120b
TAMBALA_ALLOW_SHARED_GROQ_KEY=true  # optional: explicitly let agents without dedicated keys use the existing Groq credential
OPENROUTER_API_KEY=                # optional shared OpenRouter credential; select it per agent with TAMBALA_<AGENT>_PROVIDER=openrouter
TAMBALA_RESEARCH_PROVIDER=openrouter
TAMBALA_RESEARCH_BASE_URL=https://openrouter.ai/api/v1
TAMBALA_RESEARCH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
TAMBALA_OUTREACH_API_KEY=
TAMBALA_OUTREACH_BASE_URL=
TAMBALA_OUTREACH_MODEL=
TAMBALA_WEB_SEARCH_API_KEY=   # Tavily; needed for research tasks

# --- Governance ---
TAMBALA_ENFORCE_ROLE_BINDINGS=false  # true = write tools require a bound, active role
TAMBALA_DEV_ACTIVE_ROLES=false       # local dev only (no database): treat agent roles as active

# --- Worker signatures ---
TAMBALA_SIGNING_SECRET=              # 32+ chars. Root of every employee's signing key. If unset, TAMBALA_OAUTH_SECRET is used through a one-way derivation. Keep it stable: changing it makes old signatures unverifiable.

# --- Workforce (standing duties) ---
TAMBALA_DUTY_SCHEDULER=false         # true = in-process clock runs due duties every few minutes
TAMBALA_DUTY_INTERVAL_MINUTES=5
TAMBALA_SCHEDULER_TOKEN=             # 24+ chars; lets an external cron call POST /api/duties/run (not the dashboard token)

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=                   # e.g. https://evolution.yourhost.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=                  # the instance name connected to the business number
EVOLUTION_WEBHOOK_TOKEN=             # 16+ chars. Evolution calls /webhooks/evolution?token=<this>
TAMBALA_FOUNDER_WHATSAPP=            # YOUR number, where employees reach you (e.g. +265999000111)
TAMBALA_WHATSAPP_FOUNDER_DAILY_LIMIT=40
TAMBALA_WHATSAPP_OUTBOX_SCHEDULER=false  # true on an always-on Render service to drain queued messages
TAMBALA_WHATSAPP_OUTBOX_INTERVAL_MINUTES=1

# --- Documents (PDF) ---
TAMBALA_COMPANY_NAME=Tambala Technologies Limited
TAMBALA_COMPANY_ADDRESS=Ntcheu, Malawi
TAMBALA_COMPANY_PHONE=
TAMBALA_COMPANY_EMAIL=
TAMBALA_COMPANY_WEBSITE=
TAMBALA_COMPANY_TPIN=
TAMBALA_VAT_PERCENT=0                # e.g. 16.5 if you charge VAT
TAMBALA_PAYMENT_INSTRUCTIONS=        # printed on quotations and invoices (Airtel Money / bank details)
TAMBALA_DOC_LOGO_BASE64=             # optional PNG/JPG; otherwise the TT monogram is drawn

# --- Pay / email ---
TAMBALA_PAY_API_URL=https://tambala-pay.onrender.com
TAMBALA_PAY_API_TOKEN=
RESEND_API_KEY=
TAMBALA_REPORT_TO=
TAMBALA_REPORT_FROM=
