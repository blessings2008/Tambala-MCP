{
  "name": "tambala-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Model Context Protocol server for Tambala Technologies.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts",
    "automation": "node dist/automation/job.js",
    "daily-report": "node dist/daily-report-job.js",
    "test": "tsx --test tests/organization.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "latest",
    "@modelcontextprotocol/server": "latest",
    "openai": "^6.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "tsx": "latest",
    "typescript": "latest",
    "@types/node": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
